# All project configuration lives in this single root-level file.

# Chat model providers.
SILICON_API_KEY=
SILICON_BASE_URL=
SILICON_LLM_MODEL_ID=
SILICON_USER_PROFILE_MODEL_ID=
SILICON_HISTORY_ABSTRACT_MODEL_ID=

BAI_LIAN_API_KEY=
BAI_LIAN_BASE_URL=
BAI_LIAN_LLM_MODEL_ID=
BAI_LIAN_USER_PROFILE_MODEL_ID=
BAI_LIAN_HISTORY_ABSTRACT_MODEL_ID=

OLLAMA_BASE_URL=
OLLAMA_MODEL_ID=

# Agent workspace tools.
AGENT_WORKSPACE_ROOT=
# Agent skills default to <startup directory>/skills when left empty.
AGENT_STARTUP_DIR=
AGENT_SKILLS_DIR=
AGENT_ALLOW_SHELL=true
AGENT_TOOL_MAX_OUTPUT_CHARS=30000
AGENT_MAX_FILE_CHARS=100000
AGENT_SHELL_TIMEOUT_SECONDS=120
AGENT_PYTHON_TIMEOUT_SECONDS=120
# Comma-separated command names allowed by workspace_run_shell.
AGENT_ALLOWED_SHELL_COMMANDS=Get-ChildItem,Get-Content,Get-Location,Select-String,findstr,git,dir,find,mvn,node,npm,pip,py,pytest,python,rg,tree,type,uv,where

# RAG MySQL source of truth.
RAG_MYSQL_HOST=127.0.0.1
RAG_MYSQL_PORT=3306
RAG_MYSQL_DATABASE=rag
RAG_MYSQL_USER=root
RAG_MYSQL_PASSWORD=

# Elasticsearch keyword index.
RAG_ELASTICSEARCH_URL=http://127.0.0.1:9200
RAG_ELASTICSEARCH_USERNAME=elastic
RAG_ELASTICSEARCH_PASSWORD=
RAG_ELASTICSEARCH_INDEX=rag_chunks_v1

# Milvus vector collection.
RAG_MILVUS_URI=http://127.0.0.1:19530
RAG_MILVUS_TOKEN=root:Milvus
RAG_MILVUS_COLLECTION=rag_collection_v1

# Qwen embedding model. Set the dimension explicitly when known to avoid
# loading the model while constructing the application.
RAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
RAG_EMBEDDING_DIMENSION=4096
RAG_EMBEDDING_DEVICE=auto
RAG_EMBEDDING_BATCH_SIZE=8
RAG_EMBEDDING_MAX_LENGTH=8192

# Qwen reranker. Its score is a normalized probability in [0, 1].
RAG_RERANKER_MODEL=Qwen/Qwen3-Reranker-8B
RAG_RERANKER_DEVICE=auto
RAG_RERANKER_BATCH_SIZE=2
RAG_RERANKER_MAX_LENGTH=8192
RAG_RERANKER_INSTRUCTION=Given a web search query, retrieve relevant passages that answer the query
RAG_RERANK_THRESHOLD=0.8

# Retrieval pipeline.
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_KEYWORD_TOP_K=30
RAG_VECTOR_TOP_K=30
RAG_RERANK_TOP_K=10
RAG_FINAL_TOP_K=3
RAG_RRF_K=60
